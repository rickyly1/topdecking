enum Attribute { // for "Card"
  LIGHT
  DARK
  FIRE
  WATER
  EARTH
  WIND
  DIVINE
  SPELL
  TRAP
}

enum SummonType { // for "Card"
  NORMAL
  FUSION
  SYNCHRO
  XYZ
  LINK
  RITUAL
}

enum DeckZone { // for "DeckCard"
  MAIN
  SIDE
  EXTRA
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// "Card" entity; represents a single YGO card
//
model Card {
  id          Int                     @id @default(autoincrement())
  name        String                  @unique
  attribute   Attribute               // Light, Dark, Fire, Water, Earth, Wind, Divine, Spell, Trap
  race        String?                 // (Monsters only) Dragon, Spellcaster, etc.
  summonType  SummonType?             // (Monsters only) Normal, Effect, Fusion, Synchro, etc.
  level       Int?                    // (Monsters only) Rank and Link stored here also
  atk         Int?                    // (Monsters only) '?' values will be '0'
  def         Int?                    // (Monsters only) '?" values and Link monsters will be '0'
  description String                  // Card text
  restriction Int                     // 3 = Unlimited, 2 = Semi-Limited, 1 = Limited, 0 = Forbidden

  // Relations
  monsterTypes    CardMonsterType[]   // Join table for Monster types (Flip, Tuner, etc.)
  inventoryItems  InventoryItem[]     // Inventory entries for this card
  deckCards       DeckCard[]          // Cards in decks
}

//
// Join table to store many-to-many relationship between Card and MonsterType
//
model CardMonsterType {
  cardId        Int       // ID of "Card"
  monsterTypeId Int       // ID of types for MonsterType table

  card        Card        @relation(fields: [cardId], references: [id])
  monsterType MonsterType @relation(fields: [monsterTypeId], references: [id])

  @@id([cardId, monsterTypeId])
}

//
// Lookup table for Monster Types (Flip, Tuner, etc.)
//
model MonsterType {
  id    Int    @id @default(autoincrement())
  name  String @unique   // Normal, Effect, Toon, Flip, Tuner, etc.

  cards CardMonsterType[]
}

//
// User entity
//
model User {
  id        String          @id
  email     String          @unique
  username  String          // Username for display purposes

  inventory InventoryItem[]
  decks     Deck[]
}

//
// Represents a user's overall inventory of cards
//
model InventoryItem {
  userId    String      // foreign key to User ID
  cardId    Int         // foreign key to Card ID
  quantity  Int         @default(1)

  user User @relation(fields: [userId], references: [id])
  card Card @relation(fields: [cardId], references: [id])

  @@id([userId, cardId])
}

//
// Represents a user's deck; can have multiple decks but deck name must be unique per user
//
model Deck {
  userId    String
  name      String

  user      User       @relation(fields: [userId], references: [id])
  cards     DeckCard[]

  @@id([userId, name])
}

//
// Represents a card in a deck, quantity stored inside
//
model DeckCard {
  deckUserId String
  deckName   String
  cardId     Int
  quantity   Int      @default(1)
  zone       DeckZone @default(MAIN)

  deck Deck @relation(fields: [deckUserId, deckName], references: [userId, name])
  card Card @relation(fields: [cardId], references: [id])

  @@id([deckUserId, deckName, cardId, zone])
}
